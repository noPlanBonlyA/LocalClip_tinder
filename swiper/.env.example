# Скопируйте в swiper/.env и заполните. Подробно — swiper/README.md.

# --- Сайт -------------------------------------------------------------------------------
# 0.0.0.0 не нужен: наружу сайт открывается через туннель (cloudflared), который ходит на 127.0.0.1.
HOST=127.0.0.1
PORT=3200
# Общий пароль команды для входа на сайт (обязательно, сайт смотрит в интернет).
APP_PASSWORD=
# Секрет подписи cookie: любая длинная случайная строка (пусто = сгенерируется и сохранится в data/).
SESSION_SECRET=

# Токен постоянного туннеля Cloudflare (Zero Trust -> Networks -> Tunnels). Пусто = быстрый туннель
# со случайным адресом *.trycloudflare.com, который меняется при каждом запуске.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Google Диск (OAuth, см. README: "npm run google-auth" заполнит REFRESH_TOKEN) -------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Папка из ссылки https://drive.google.com/drive/folders/<ID>, внутри неё лежат "to sort", "montage", "trash".
DRIVE_ROOT_FOLDER_ID=1TUTNzuNI8n9tv5NlN72EKkdZYHuP6GsH
DRIVE_TO_SORT_NAME=to sort
DRIVE_MONTAGE_NAME=montage
DRIVE_TRASH_NAME=trash
# Куда внутри montage/<стример>/ переносится исходник после монтажа (пусто = оставить рядом с готовым).
DRIVE_SOURCES_SUBFOLDER=исходники
# Как часто перечитывать "to sort", секунды.
SYNC_INTERVAL_SEC=60

# --- CRM ---------------------------------------------------------------------------------
# Базовый адрес API CRM (Railway, не сайт на Vercel). Пусто = без CRM.
CRM_API_URL=https://api-production-34217a49.up.railway.app
# Отдельный пользователь CRM для свайпера (создайте в разделе «Команда»).
CRM_LOGIN=
CRM_PASSWORD=

# --- LocalClip ---------------------------------------------------------------------------
LOCALCLIP_API_URL=http://127.0.0.1:8000
# .env LocalClip, откуда берётся BACKEND_AUTH_SECRET (по умолчанию — соседний ../.env).
LOCALCLIP_ENV_FILE=../.env
# База LocalClip (фиксирована в LocalClip.ps1) — нужна, чтобы найти id встроенного пользователя.
LOCALCLIP_DATABASE_URL=postgresql://supoclip:supoclip_password@127.0.0.1:5433/supoclip
# Можно указать id пользователя явно, тогда база не нужна.
LOCALCLIP_USER_ID=
# Параметры задачи LocalClip (JSON, необязательно): caption_template, processing_mode, add_subtitles...
LOCALCLIP_TASK_OPTIONS={"processing_mode":"balanced","output_format":"vertical","add_subtitles":true}
# Максимум ожидания одного монтажа, минуты.
LOCALCLIP_TIMEOUT_MIN=120
